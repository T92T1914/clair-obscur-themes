<settings>
    <setting propertyKey="@Properties.appearance" title="@Strings.AppearanceTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.ClairLabel</listEntry>
            <listEntry value="1">@Strings.ObscurLabel</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.leftData" title="@Strings.LeftDataTitle">
